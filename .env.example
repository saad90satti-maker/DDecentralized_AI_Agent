# ============= DECENTRALIZED AI AGENT — ENVIRONMENT TEMPLATE =============
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
# Usage: cp .env.example .env
# =======================================================================

# ============= LLM BACKEND (pick at least one) =============
# Gemini (primary)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_TOKEN=your_gemini_api_token_here
GEMINI_API_MODEL=models/gemini-2.5-flash
GEMINI_MODEL=models/gemini-2.5-flash

# ============= HERMES / OLLAMA (fallback) =============
HERMES_URL=http://localhost:11434
HERMES_MODEL=llama3.2:1b

# ============= BROWSER AUTOMATION =============
HEADLESS_BROWSER=false
BROWSER_USER_DATA_DIR=

# ============= EMAIL =============
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_app_password_here

# ============= DISCORD =============
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# ============= GITHUB =============
GITHUB_TOKEN=your_github_token_here

# ============= GROQ =============
GROQ_API_KEY=your_groq_api_key_here

# ============= HUGGINGFACE (optional) =============
HUGGINGFACE_TOKEN=your_hf_token_here
HF_API_TOKEN=your_hf_token_here
HF_MODEL=NousResearch/Nous-Hermes-2-Mistral-7B-DPO

# ============= OPENROUTER (optional) =============
OPENROUTER_KEY=
OPENROUTER_MODEL=nousresearch/nous-hermes-2-mistral-7b-dpo

# ============= CLOUDFLARE =============
CLOUDFLARE_TOKEN=your_cloudflare_token_here

# ============= SWARM SECURITY =============
SWARM_SECRET=change-this-to-a-random-secret

# ============= X (TWITTER) API =============
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ============= TELEGRAM =============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============= LOGGING =============
LOG_LEVEL=INFO
