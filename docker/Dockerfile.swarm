FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN pip install --no-cache-dir cryptography kademlia

COPY ghost_swarm.py .
COPY docker/entrypoint.py /entrypoint.py

RUN mkdir -p /shared /app/agent_data/swarm

EXPOSE 9876 9877 8468

ENTRYPOINT ["python", "/entrypoint.py"]
